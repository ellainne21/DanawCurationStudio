<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Danaw.App.ViewModels"
        xmlns:ent="using:Danaw.Core.Entities"
        x:Class="Danaw.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DANAW Curation Studio"
        Width="1000" Height="650">

	<DockPanel Margin="16">

		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12">
			<TextBlock Text="Signed in as:" VerticalAlignment="Center" />
			<ComboBox ItemsSource="{Binding Reviewers}"
					  SelectedItem="{Binding CurrentUser}"
					  MinWidth="280">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="ent:Reviewer">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Text="{Binding FullName}" />
							<TextBlock Text="{Binding Role}" Opacity="0.6" />
						</StackPanel>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</StackPanel>

		<TextBlock DockPanel.Dock="Bottom"
				   Margin="0,12,0,0"
				   TextWrapping="Wrap"
				   Text="{Binding StatusMessage}" />

		<TextBlock Text="The Content Review Queue will appear here."
				   HorizontalAlignment="Center"
				   VerticalAlignment="Center"
				   Opacity="0.6" />
	</DockPanel>
</Window>